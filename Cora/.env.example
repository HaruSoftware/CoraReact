# Copie para .env para desenvolvimento local e substitua os valores.
# No Render, configure as variaveis no painel do servico; nao envie este arquivo.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_LONGO_E_ALEATORIO
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000/api
# No Render, use a URL absoluta do servico da API terminando em /api.
# Exemplo: https://cora-api.onrender.com/api

# O login Google e opcional. Preencha somente se for utiliza-lo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
